def carregar_dados_experimentais(archive_iv, archive_cv):
    """Lê as planilhas I-V e C-V, detecta a polaridade direta e ordena os vetores."""
    df_iv = pd.read_excel(archive_iv)
    V1_all = pd.to_numeric(df_iv["AnodeV"], errors="coerce").to_numpy()
    I1_all_signed = pd.to_numeric(df_iv["AnodeI"], errors="coerce").to_numpy()

    valid_iv = ~np.isnan(V1_all) & ~np.isnan(I1_all_signed)
    V1_all = V1_all[valid_iv]
    I1_all_signed = I1_all_signed[valid_iv]
    I1_all_abs = np.abs(I1_all_signed)

    idx_all = np.argsort(V1_all)
    V1_all = V1_all[idx_all]
    I1_all_signed = I1_all_signed[idx_all]
    I1_all_abs = I1_all_abs[idx_all]

    i_max_pos = np.max(I1_all_abs[V1_all > 0]) if np.any(V1_all > 0) else 0.0
    i_max_neg = np.max(I1_all_abs[V1_all < 0]) if np.any(V1_all < 0) else 0.0

    if i_max_neg > i_max_pos * 10:
        mask_fwd = V1_all <= 0
        V1 = -V1_all[mask_fwd]
        I1 = I1_all_abs[mask_fwd]
    else:
        mask_fwd = V1_all >= 0
        V1 = V1_all[mask_fwd]
        I1 = I1_all_abs[mask_fwd]

    idx_iv = np.argsort(V1)
    V1, I1 = V1[idx_iv], I1[idx_iv]

    df_cv = pd.read_excel(archive_cv)
    V2_raw = pd.to_numeric(df_cv["DCV_AC"], errors="coerce").to_numpy()
    C_raw = pd.to_numeric(df_cv["Cp_AC"], errors="coerce").to_numpy()

    valid_cv = ~np.isnan(V2_raw) & ~np.isnan(C_raw)
    V2_raw, C_raw = V2_raw[valid_cv], C_raw[valid_cv]

    V2 = -V2_raw if np.median(V2_raw) < 0 else V2_raw
    mask_rev = (V2 >= 0) & (C_raw > 0)
    idx_cv = np.argsort(V2[mask_rev])
    V2 = V2[mask_rev][idx_cv]
    C = C_raw[mask_rev][idx_cv]

    if np.median(C) > 1e-6:
        C = C * 1e-12

    return V1_all, I1_all_signed, I1_all_abs, V1, I1, V2, C


def extrair_parametros_iv(V1, I1, T, faixa_exp=None, faixa_lin=None, filtrar_compliance=True):
    """Extrai n, Is, S1 e Rd (com incertezas ±1σ) a partir da curva I-V direta."""
    i_max = I1.max()

    # 1. Região Exponencial: ln(I) = ln(Is) + (q / (n * kB * T)) * V
    if faixa_exp is None:
        mask_auto_exp = (I1 >= max(1e-8, i_max * 1e-6)) & (I1 <= i_max * 0.05)
        if mask_auto_exp.sum() >= 4:
            faixa_exp = (float(V1[mask_auto_exp].min()), float(V1[mask_auto_exp].max()))
        else:
            faixa_exp = (float(np.percentile(V1, 20)), float(np.percentile(V1, 45)))

    mask_exp = (V1 >= faixa_exp[0]) & (V1 <= faixa_exp[1]) & (I1 > 0)
    reg_exp = linregress(V1[mask_exp], np.log(I1[mask_exp]))

    n = q / (reg_exp.slope * kB * T)
    err_n = n * (reg_exp.stderr / reg_exp.slope)
    Is = np.exp(reg_exp.intercept)
    rel_err_Is = reg_exp.intercept_stderr

    # 2. Região Resistiva Linear: I = S1 * V + b
    if faixa_lin is None:
        teto = 0.95 * i_max if filtrar_compliance else i_max
        mask_auto_lin = (I1 >= 0.45 * i_max) & (I1 <= teto)
        if mask_auto_lin.sum() >= 4:
            faixa_lin = (float(V1[mask_auto_lin].min()), float(V1[mask_auto_lin].max()))
        else:
            faixa_lin = (float(np.percentile(V1, 75)), float(V1.max()))

    mask_lin = (V1 >= faixa_lin[0]) & (V1 <= faixa_lin[1])
    reg_lin = linregress(V1[mask_lin], I1[mask_lin])
    S1, err_S1 = reg_lin.slope, reg_lin.stderr

    Rd = 1.0 / S1
    err_Rd = Rd * (err_S1 / S1)

    return {
        "n": n, "err_n": err_n,
        "Is": Is, "rel_err_Is": rel_err_Is,
        "S1": S1, "err_S1": err_S1,
        "Rd": Rd, "err_Rd": err_Rd,
        "reg_exp": reg_exp, "mask_exp": mask_exp,
        "reg_lin": reg_lin, "mask_lin": mask_lin,
        "faixa_exp": faixa_exp, "faixa_lin": faixa_lin,
    }


def extrair_parametros_cv(V2, C, faixa_cv=None):
    """Extrai a inclinação S2 (com incerteza ±1σ) da linearização 1/C^2 vs Vr."""
    if faixa_cv is None:
        faixa_cv = (max(1.0, float(V2.max() * 0.1)), float(V2.max() * 0.9))

    mask_cv = (V2 >= faixa_cv[0]) & (V2 <= faixa_cv[1]) & (C > 0)
    reg_cv = linregress(V2[mask_cv], 1.0 / (C[mask_cv] ** 2))
    S2, err_S2 = reg_cv.slope, reg_cv.stderr

    return {
        "S2": S2, "err_S2": err_S2,
        "reg_cv": reg_cv, "mask_cv": mask_cv,
        "faixa_cv": faixa_cv,
    }


def calcular_parametros_fisicos(iv_res, cv_res, material_cls, T, V_eff):
    """Calcula ND, LD, A e phi_b (com propagação analítica ±1σ) usando a classe do material."""
    S1, err_S1 = iv_res["S1"], iv_res["err_S1"]
    S2, err_S2 = cv_res["S2"], cv_res["err_S2"]
    Is, rel_err_Is = iv_res["Is"], iv_res["rel_err_Is"]

    eps = material_cls.epsilon
    mu_300 = material_cls.electronMobility
    A_star = material_cls.A_star

    # Concentração média de dopantes ND [cm^-3]
    ND = (S1 * eps * np.sqrt(V_eff * S2)) / (q * mu_300)
    rel_err_ND = np.sqrt((err_S1 / S1) ** 2 + (0.5 * err_S2 / S2) ** 2)
    err_ND = ND * rel_err_ND

    # Espessura da região de deriva LD [cm e um]
    LD_cm = np.sqrt((2.0 * eps * V_eff) / (q * ND))
    LD_um = LD_cm * 1e4
    err_LD_um = LD_um * (0.5 * rel_err_ND)

    # Área ativa efetiva A [cm^2]
    A = np.sqrt(2.0 / (S2 * q * ND * eps))
    rel_err_A = np.sqrt((-0.5 * err_S1 / S1) ** 2 + (-0.75 * err_S2 / S2) ** 2)
    err_A = A * rel_err_A

    # Altura de barreira Schottky phi_b [V]
    phi_b = (kB * T / q) * np.log((A * A_star * (T ** 2)) / Is)
    err_phi_b = (kB * T / q) * np.sqrt(rel_err_A ** 2 + rel_err_Is ** 2)

    return {
        "ND": ND, "err_ND": err_ND,
        "LD_cm": LD_cm, "LD_um": LD_um, "err_LD_um": err_LD_um,
        "A": A, "err_A": err_A,
        "phi_b": phi_b, "err_phi_b": err_phi_b,
    }


def calcular_perfil_deplecao(V2, C, A, material_cls, suavizar=True):
    """Calcula W_R(Vr) [um] e o perfil local de dopagem N_D(W_R) [cm^-3]."""
    eps = material_cls.epsilon
    WR_cm = (eps * A) / C
    WR_um = WR_cm * 1e4

    inv_C2 = 1.0 / (C ** 2)
    if suavizar and len(V2) >= 61:
        inv_C2_proc = savgol_filter(inv_C2, window_length=61, polyorder=2)
    else:
        inv_C2_proc = inv_C2

    d_invC2_dV = np.gradient(inv_C2_proc, V2)
    ND_perfil = 2.0 / (q * eps * (A ** 2) * d_invC2_dV)

    return WR_um, ND_perfil


